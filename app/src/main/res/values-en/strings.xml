    <string name="method_blur">Blur</string>
    <string name="method_blur_desc">Heavily blurs the area. The watermark becomes unreadable but the area stays visible.</string>
    <string name="method_pixelate">Pixelate</string>
    <string name="method_pixelate_desc">Replaces the area with large pixels.</string>
