<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="library/thumbs/" />
        <!-- Downloaded update APKs: large, re-downloadable, and never verified on another device. -->
        <exclude domain="file" path="updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="library/thumbs/" />
        <exclude domain="file" path="updates/" />
    </device-transfer>
</data-extraction-rules>
