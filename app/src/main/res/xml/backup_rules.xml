<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The cache dir (temporary exports) is never backed up by Android. Thumbnails are large
         and regenerable; the library index (files/library/index.json) is kept.
         Downloaded update APKs are explicitly excluded: they are large, they are re-downloadable,
         and restoring one from a cloud backup would mean installing a file that was never
         verified on this device. -->
    <exclude domain="file" path="library/thumbs/" />
    <exclude domain="file" path="updates/" />
</full-backup-content>
